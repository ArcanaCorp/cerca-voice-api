# SOLO EN EL SERVIDOR (Vercel). Nunca incluir en la APK.
OPENAI_API_KEY=REEMPLAZAR_SOLO_EN_VERCEL
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_TEXT_MODEL=gpt-4.1-mini

# Límites. Requiere Redis HTTP de Upstash en producción.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=agregar-una-cadena-aleatoria-larga
REQUESTS_PER_MINUTE=10
DAILY_REQUESTS_LIMIT=1000

# Solo pruebas internas API-a-API. Nunca incrustar este token en una APK.
API_ACCESS_TOKEN=

# Orígenes autorizados en caso de navegador; las apps móviles no dependen de CORS.
ALLOWED_ORIGINS=
