# Variables privadas de Vercel. NO incluir claves en Expo ni publicarlas en GitHub.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Algunos modelos gratis no aceptan JSON mode. Déjalo deshabilitado inicialmente.
OPENROUTER_JSON_MODE=false
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Protección obligatoria para llamadas anónimas en Vercel production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=
REQUESTS_PER_MINUTE=8
DAILY_REQUESTS_LIMIT=45

# Solo server-to-server, NO incrustar en una APK.
API_ACCESS_TOKEN=
ALLOWED_ORIGINS=

# Trazas estructuradas para diagnosticar errores en Vercel. No incluyen tokens ni audio.
CERCA_DEBUG_LOGS=true
